# Environment: "development" (local fallbacks) or "production" (Supabase)
ENVIRONMENT=development

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (required when ENVIRONMENT=production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# GitHub OAuth (for NextAuth sign-in)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# NextAuth
NEXTAUTH_SECRET=your_random_nextauth_secret_here

# Render deployment (used by keepalive.py to ping /health)
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Deployed frontend origin, added to CORS allow_origins alongside localhost
FRONTEND_URL=https://your-frontend.vercel.app
